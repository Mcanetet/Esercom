PORT=3000
JWT_SECRET=esercom-cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h
NODE_ENV=development

# Clave maestra para https://tudominio.cl/acceso-sistema.html
ADMIN_PORTAL_PASSWORD=tu-clave-admin-segura

# Base de datos:
#   sqlite (default, local)  → data/*.db + npm run init-db
#   mysql (Bluehosting / gosercom.cl) → misma BD productiva PHP
# DB_DRIVER=sqlite

# --- Bluehosting / Opción A (MySQL compartida) ---
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=tu_usuario_cpanel
# DB_PASSWORD=tu_password_mysql
# DB_NAME=gosercom_productivo_db
