PORT=3000
# OBLIGATORIO en producción (≥32 caracteres aleatorios). Sin esto la app no arranca.
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio-32chars
# Opcional: clave AES distinta para cifrar API keys en BD
# ENCRYPTION_KEY=
JWT_EXPIRES_IN=8h
NODE_ENV=development

# Clave maestra para /acceso-sistema.html (obligatoria en producción)
ADMIN_PORTAL_PASSWORD=tu-clave-admin-segura

# Clave portal entrenamiento Angel /acceso-angel.html (obligatoria en producción)
ANGEL_TRAIN_PASSWORD=tu-clave-angel-segura

# Orígenes CORS permitidos (vacío = same-origin / sin restringir lista)
# CORS_ORIGINS=https://esercom.cl,https://www.esercom.cl

# Base de datos:
#   sqlite (default, local)  → data/*.db + npm run init-db
#   mysql (Bluehosting / gosercom.cl) → misma BD productiva PHP
# DB_DRIVER=sqlite

# --- Bluehosting / MySQL ---
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=tu_usuario_cpanel
# DB_PASSWORD=tu_password_mysql
# DB_NAME=gosercom_productivo_db
#
# Multiempresa (una BD física por marca). SERCOM = DB_NAME; el resto:
# DB_PER_COMPANY=1
# DB_NAME_GLOBAL=gosercom_global_db
# DB_NAME_NEXUS=gosercom_nexus_db
# DB_NAME_TACTICA=gosercom_tactica_db
# DB_NAME_INTERCANJE=gosercom_intercanje_db
# (opcional) DB_NAME_SERCOM=gosercom_productivo_db
# Luego: node scripts/create-company-dbs.js  y reiniciar Node
#
# Sin DB_PER_COMPANY: todas las marcas usan la misma BD (legado).
# --- Angel IA / OpenAI (recomendado en producción) ---
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Consulta patentes vehiculares Chile (Boostr — opcional)
# BOOSTR_API_KEY=tu_api_key_boostr

# Catálogo flota — alertas por patente no encontrada
# FLOTA_ALERT_EMAIL=flota@serviciossercom.cl

# SMTP para envío de correos (cPanel) — requerido para recuperar contraseña
# SMTP_HOST=mail.serviciossercom.cl
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notificaciones@serviciossercom.cl
# SMTP_PASS=tu_password
# SMTP_FROM="ESERCOM <notificaciones@serviciossercom.cl>"

# Clave exclusiva entrenamiento Angel IA (URL oculta /acceso-angel.html)
# ANGEL_TRAIN_PASSWORD=tu-clave-entrenamiento-segura
